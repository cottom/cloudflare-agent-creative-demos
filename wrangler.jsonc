{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-creative-agent-demos",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "LLM_MODEL": "@cf/moonshotai/kimi-k2.6",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    "PUBLIC_ORIGIN": "https://cloudflare-creative-agent-demos.cottom-zw.workers.dev"
  },
  "ai": { "binding": "AI", "remote": true },
  // Browser Run: the durable build workflow drives PPTist's layout engine
  // headlessly, since that engine only exists in a browser.
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "creative-agent-demo-artifacts" }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PPT_PROJECT", "class_name": "PptProject" },
      { "name": "CANVAS_PROJECT", "class_name": "CanvasProject" },
      { "name": "STUDIO_AGENT", "class_name": "StudioAgent" },
      { "name": "TENANT", "class_name": "Tenant" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PptProject", "CanvasProject", "StudioAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Tenant"] }
  ],
  // Keyed by tenant, not IP: this is a server-to-server API where one
  // integrator's traffic all shares an address. Reads are far cheaper than
  // writes (which fan out to AI inference and workflows), so they get separate
  // budgets rather than one shared ceiling.
  "ratelimits": [
    { "name": "READ_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "workflows": [
    { "name": "PPT_BUILD_WORKFLOW", "binding": "PPT_BUILD_WORKFLOW", "class_name": "PptBuildWorkflow" },
    { "name": "CANVAS_VARIANTS_WORKFLOW", "binding": "CANVAS_VARIANTS_WORKFLOW", "class_name": "CanvasVariantsWorkflow" }
  ]
}
